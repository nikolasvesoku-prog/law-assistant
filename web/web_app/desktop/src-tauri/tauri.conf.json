{
  "productName": "law-assistant",
  "version": "1.0.5",
  "identifier": "com.lawassistant.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ..\\..\\client && npm run build",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Правовой помощник",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
"active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
"nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "nsis-img/sidebar.bmp",
        "template": "template.nsi",
        "languages": ["Russian", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
"active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBMzkyNzU2N0ZENjI1QjIKUldTeUpkWi9WaWM1dXUwVTlXamNvV2ViOTR0eWI5M0lsN0tjNXpLdGIxVEZUaDFZRWF4Mk5DaHEK",
"endpoints": [
        "https://github.com/nikolasvesoku-prog/law-assistant/releases/latest/download/latest.json"
      ]
    }
  }
}