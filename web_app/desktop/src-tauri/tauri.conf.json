{
  "productName": "Правовой помощник",
  "version": "1.1.5",
  "identifier": "com.lawassistant.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ..\\..\\client && npm run build",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Правовой помощник",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3OEU4NjUzRUZGOTBDOUEKUldTYURQbnZVNGFPZDBSMjR6R1ZyemFCR0c4MW5qZ0pmMUphdGZXekJxR2JVT0pxN0xvUWJpUEcK",
      "endpoints": [
        "https://github.com/nikolasvesoku-prog/law-assistant/releases/latest/download/latest.json"
      ]
    }
  }
}
